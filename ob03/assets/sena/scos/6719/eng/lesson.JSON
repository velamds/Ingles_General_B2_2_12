{"_data": [{"contents": [{"content": "So Much to Do at Work", "type": "lesson_name"}, {"content": "Meeting the Author", "type": "unit_name"}, {"content": 3, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 12, "type": "lesson"}, {"content": "B2.2", "type": "level"}], "type": "metadata"}, {"contents": [{"content": "false", "type": "test"}], "type": "achievment_test"}, {"contents": [{"content": " Discuss factual and abstract information about common everyday or job related topics in both work and social contexts appropriate for the interlocutor.", "type": "primary"}, {"content": " Integrates a wider range of written and spoken language skills and knowledge when dealing with problems and difficulties in the workplace.", "type": "secondary_1"}, {"content": " Understands the main ideas and specific information of complex text on both concrete and abstract topics in written texts in social and work contexts.", "type": "secondary_2"}, {"content": " Understands the main ideas and specific information of complex text on both concrete and abstract topics in written texts in social and work contexts.", "type": "secondary_3"}, {"content": " Understands the main ideas and specific information of complex text on both concrete and abstract topics in written texts in social and work contexts.", "type": "secondary_4"}, {"content": " Understands the main ideas and specific information of complex text on both concrete and abstract topics in written texts in social and work contexts.", "type": "secondary_5"}, {"content": " Understands the main ideas and specific information of complex text on both concrete and abstract topics in written texts in social and work contexts.", "type": "secondary_6"}, {"content": " Understands the main ideas and specific information of complex text on both concrete and abstract topics in written texts in social and work contexts.", "type": "secondary_7"}, {"content": " Understands the main ideas and specific information of complex text on both concrete and abstract topics in written texts in social and work contexts.", "type": "secondary_8"}], "type": "objectives"}, {"contents": [{"content": "to activate", "type": "name"}, {"content": "to make something start working", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: You need to activate your number so you can make and receive calls.", "type": "example"}, {"content": "engenn10le12ob03aud01", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": " These are words you may use when talking about setting up a meeting. ", "type": "text"}], "type": "target_word_describer"}, {"contents": [{"content": "mailbox", "type": "name"}, {"content": "a system for managing telephone messages", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: You haven't set up your voice mailbox.", "type": "example"}, {"content": "engenn10le12ob03aud02", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "to blink", "type": "name"}, {"content": "to go on and off quickly", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: I wondered why the light on the answering machine never blinked.", "type": "example"}, {"content": "engenn10le12ob03aud03", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "to pick up the pace ", "type": "name"}, {"content": "to go faster", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: You're going to have to pick up the pace.", "type": "example"}, {"content": "engenn10le12ob03aud04", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "to fall behind", "type": "name"}, {"content": "to become less successful than other people", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: You don't want to be falling behind, do you?", "type": "example"}, {"content": "engenn10le12ob03aud05", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "turn up nothing", "type": "name"}, {"content": "find nothing even when searching for it thoroughly", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: My research has turned up nothing!", "type": "example"}, {"content": "engenn10le12ob03aud06", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "redundant", "type": "name"}, {"content": "exceeding what is usual or necessary", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: It seems redundant to leave a message as well.", "type": "example"}, {"content": "engenn10le12ob03aud07", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "around the block ", "type": "name"}, {"content": "to have had a lot of experience with something ", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: As someone who has been around the block a few times, I suggest you leave him a message.", "type": "example"}, {"content": "engenn10le12ob03aud08", "type": "audio"}], "type": "target_word"}, {"content": "engenn10le12ob03re1img01.jpg", "type": "background_image"}, {"contents": [{"content": "The Present Perfect with Past Tenses", "type": "heading"}, {"content": "The<span class=\"italic\"> Present Perfect </span>tense is often used with other tenses.", "type": "describer"}, {"content": "You use the <span class=\"italic\">Present Perfect</span> with past tenses to:<br/><br/>  1. describe events or states that began and have continued after a time in the past. You use the words <span class=\"italic\">ever since</span>, <span class=\"italic\">since</span> etc.<br/><br/> For example:<br/><br/>  <span class=\"italic\">He'<span class=\"strong\">s been</span> very considerate towards his co-workers <span class=\"strong\">since we had</span> a conversation.<br/> <span class=\"strong\">Ever since</span> I first <span class=\"strong\">saw</span> her, I'<span class=\"strong\">ve been wondering</span> where she comes from.</span><br/><br/>  2. describe repeated or long-term thoughts or feelings about events in the past. <br/><br/>  For example:<br/> <br/> <span class=\"italic\">I'<span class=\"strong\">ve often asked myself</span> why she <span class=\"strong\">chose</span> to become an astronaut.<br/> I'<span class=\"strong\">ve always said</span> I <span class=\"strong\">made</span> the wrong choice when I accepted that position.</span>", "type": "text"}, {"content": "I'<span class=\"strong\">ve wondered</span> why my phone never <span class=\"strong\">blinked</span>. ", "type": "example"}, {"content": "I <span class=\"strong\">started</span> late as I'<span class=\"strong\">ve felt</span> a bit under the weather.", "type": "example"}, {"content": "I <span class=\"strong\">sent</span> him an e-mail since I <span class=\"strong\">haven't spoken</span> to him at all.", "type": "example"}], "type": "learning_points"}, {"contents": [{"content": " The Future Perfect Continuous: Stating the Cause of Something in the Future", "type": "heading"}, {"content": "You can use the <span class=\"strong\">Future Perfect Continuous</span> before another action in the future to show <span class=\"underline\">cause </span>and <span class=\"underline\">effect</span>.", "type": "describer"}, {"content": "For example:<br/><br/>  <span class=\"italic\">Jason will be tired when he gets home because he<span class=\"strong\"> will have been running</span> for over an hour.</span><br/><br/>  In this example, the cause of Jason being tired is that he will have been running for a long time. You use this tense to project yourself into the future and look back on events leading up to that point.<br/><br/>  The form of the <span class=\"strong\">Future Perfect Continuous </span>tense is:<br/><br/>  subject + will have been + verb-ing", "type": "text"}, {"content": "You<span class=\"strong\"> will have been working </span>with BFP for a month next week.", "type": "example"}, {"content": "I will be finished because I <span class=\"strong\">will have been working </span>for 12 hours before I head home.", "type": "example"}, {"content": "You'll be tired because you<span class=\"strong\"> will have been travelling</span> 4 hours by the time you get back to Boston.", "type": "example"}], "type": "learning_points"}, {"contents": [{"content": "Think of someone you know who has been working in a certain industry for a long time. ", "type": "text"}, {"content": "Write down 10 questions you can ask them. Think of questions where the answer will start with <span class=\"italic\">I will have been + verb-ing \u2026 </span>", "type": "text"}, {"content": "Set up an interview with this professional and ask them your questions.", "type": "text"}, {"content": "Write down their answers. ", "type": "text"}, {"content": "Use all the answers to write a paragraph about them.", "type": "text"}], "type": "takeaway_extension"}, {"contents": [{"content": "I come up with questions to ask about the progress of actions.", "type": "text"}, {"content": "I talk about events related to work.", "type": "text"}, {"content": "I summarize information gathered from an interview.", "type": "text"}], "type": "takeaway_assessment"}], "labs": [{"stimuli": [{"template_override": 1, "contents": [{}], "_data": [], "id": 0, "type": "welcome"}, {"template_override": 1, "_data": [], "title": "", "type": "audio", "contents": [{"value": {"images": [{"image": "engenn10le12ob03re2img05.jpg", "time": "0", "id": 0, "text": ""}, {"image": "engenn10le12ob03re2img05.jpg", "time": "100", "id": 1, "text": "<span class=\"strong\">Adam</span>: Adam Bari here.<br><span class=\"strong\">Boris</span>: Hello Adam. This is Boris.<br><span class=\"strong\">Adam</span>: Hello, Mr. Brody.<br><span class=\"strong\">Boris</span>: Mr. Bari, you will have been working with BFP for a month next week. Yet, you still haven't activated your mailbox.<br><span class=\"strong\">Adam</span>: I'll get that sorted out. I've wondered why my phone never blinked. How is Chicago?<br><span class=\"strong\">Boris</span>: Good."}, {"image": "engenn10le12ob03re2img06.jpg", "time": "18000", "id": 2, "text": "<span class=\"strong\">Adam</span>: You'll be tired because you will have been traveling 4 hours by the time you get back to Boston.<br><span class=\"strong\">Boris</span>: Yes, Mr. Bari. On to more important matters, have you completed your assignment?<br><span class=\"strong\">Adam</span>: No. I have been working on it since yesterday. I started late as I've felt a bit under the weather.<br><span class=\"strong\">Boris</span>: You'll need to pick up the pace. You don't want to be falling behind, do you?<br><span class=\"strong\">Adam</span>: No, Mr. Brody. I will be finished because I will have worked for 12 hours before I head home. I've tried to set up a meeting with the author since my research turned up nothing.<br><span class=\"strong\">Boris</span>: You need to get on that right away. Mr. Duncan is a busy man.<br><span class=\"strong\">Adam</span>: I understand. I sent him an e-mail since I haven't spoken to him at all.<br><span class=\"strong\">Boris</span>: Have you called his office?"}, {"image": "engenn10le12ob03re2img07.jpg", "time": "58000", "id": 3, "text": "<span class=\"strong\">Adam</span>: I called a few times but no one has picked up.<br><span class=\"strong\">Boris</span>: Did you leave a message?<br><span class=\"strong\">Adam</span>: No I assumed that if someone was there, they would have picked up.<br><span class=\"strong\">Boris</span>: The correct thing to do would be to leave a voicemail message.<br><span class=\"strong\">Adam</span>: I sent him an e-mail. It seems redundant to leave a message as well.<br><span class=\"strong\">Boris</span>: I'll have been working in this industry 10 years next month. As someone who's been around the block a few times, I suggest you leave him a message.<br><span class=\"strong\">Adam</span>: Alright, Mr. Brody."}], "audiosrc": "engenn10le12ob03re2aud01", "coverimg": "engenn10le12ob03re2img05.jpg"}, "type": "slideshow"}], "id": 1}], "exercises": [{"template_override": 1, "_data": [{"contents": [{"content": " I can talk about an unusual or unique event related to work topics.", "type": "Learning Outcomes"}, {"content": " I can request or report facts about events or actions related to work issues.", "type": "Learning Outcomes"}, {"content": " I can talk about expectations for the future.", "type": "Learning Outcomes"}, {"content": "What do you do if you can't reach someone?", "type": "Free Header Item"}, {"content": "What do you think is the best way to reach someone? Why?", "type": "Free Header Item"}], "type": "instructions"}, {"contents": [{"content": "Welcome", "type": "group_name"}], "type": "group"}, {"content": {"attempt_feedback": [{"content": "You have 2 tries", "type": "text"}, {"content": "you have 1 attempt left", "type": "text"}], "incorrect_feedback": [{"content": "try again", "type": "text"}, {"content": "Maybe next time", "type": "text"}], "correct_feedback": "Correct", "allowed_attempts": 2}, "type": "feedback"}, {"content": " Ask your partner:", "type": "free_header_text"}, {"content": " It's time to set up a meeting!", "type": "free_type_text_area"}], "questions": [], "type": "WLC", "id": 0, "img_path": "", "stimuli_ids": [0]}, {"template_override": 1, "_data": [{"contents": [{"content": " \nAdam receives an important phone call. Who's it from? Do they leave a <span class=\"tool-tip\" id=\"tip_1_0\">voicemail</span> message?\n", "type": "text"}], "type": "instructions"}, {"contents": [{"content": "Content", "type": "group_name"}], "type": "group"}, {"content": {"attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_f