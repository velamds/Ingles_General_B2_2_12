{"_data": [{"type": "metadata", "contents": [{"type": "lesson_name", "content": "So Much to Do at Work"}, {"type": "unit_name", "content": "Business Ethics"}, {"type": "position", "content": 7}, {"type": "origin", "content": "stub"}, {"type": "lesson", "content": 12}, {"type": "level", "content": "B2.2"}]}, {"type": "achievment_test", "contents": [{"type": "test", "content": "false"}]}, {"type": "objectives", "contents": [{"type": "primary", "content": "Discuss factual and abstract information about common everyday or job related topics in both work and social contexts appropriate for the interlocutor."}, {"type": "secondary_1", "content": "Understands the main ideas and specific information of complex text on both concrete and abstract topics in written texts in social and work contexts."}, {"type": "secondary_2", "content": "Understands the main ideas and specific information of complex text on both concrete and abstract topics in written texts in social and work contexts."}, {"type": "secondary_3", "content": "Integrates a wider range of written and spoken language skills and knowledge when dealing with problems and difficulties in the workplace."}, {"type": "secondary_4", "content": "Understands the main ideas and specific information of complex text on both concrete and abstract topics in written texts in social and work contexts."}, {"type": "secondary_5", "content": "Understands the main ideas and specific information of complex text on both concrete and abstract topics in written texts in social and work contexts."}, {"type": "secondary_6", "content": "Understands the main ideas and specific information of complex text on both concrete and abstract topics in written texts in social and work contexts."}, {"type": "secondary_7", "content": "Integrates a wider range of written and spoken language skills and knowledge when dealing with problems and difficulties in the workplace."}, {"type": "secondary_8", "content": "Integrates a wider range of written and spoken language skills and knowledge when dealing with problems and difficulties in the workplace."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "plagiarism"}, {"type": "definition", "content": "using another person's words, ideas, or work and pretending it is your own"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: This work \"borrowing\" is also known as plagiarism."}, {"type": "audio", "content": "engenn10le12ob07aud01"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": " These are words you use when talking about business ethics."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "ad campaign "}, {"type": "definition", "content": "a series of advertisements intended to achieve a particular result relating to business"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Their idea for the ad campaign was stolen by the competition."}, {"type": "audio", "content": "engenn10le12ob07aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "creator"}, {"type": "definition", "content": "someone who made a particular thing"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: The are the creators of this program."}, {"type": "audio", "content": "engenn10le12ob07aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "credit"}, {"type": "definition", "content": "praise that you give to someone for something they have done"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: The creators of the program were not given any credit. "}, {"type": "audio", "content": "engenn10le12ob07aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to count "}, {"type": "definition", "content": "to be considered in a particular way"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: Not giving the creator credit counts as plagiarism. "}, {"type": "audio", "content": "engenn10le12ob07aud05"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "copyrighted"}, {"type": "definition", "content": "protected by copyright"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: Being caught plagiarizing copyrighted work can lead to fines. "}, {"type": "audio", "content": "engenn10le12ob07aud06"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "proprietary"}, {"type": "definition", "content": "relating to who owns something"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: Using an image to promote your program or anything that is part of a proprietary software which is being protected by copyright laws is also against the law. "}, {"type": "audio", "content": "engenn10le12ob07aud07"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to mimic "}, {"type": "definition", "content": "to copy the way someone does something "}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: Don't create a design that closely mimics the original."}, {"type": "audio", "content": "engenn10le12ob07aud08"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "influenced"}, {"type": "definition", "content": "to be affected by someone or something "}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: You may have stepped over the line from influenced, to copycat."}, {"type": "audio", "content": "engenn10le12ob07aud09"}]}, {"type": "background_image", "content": "engenn10le12ob07re1img01.jpg"}, {"type": "learning_points", "contents": [{"type": "heading", "content": "Passive Infinitives and Gerunds"}, {"type": "describer", "content": "You use the passive infinitive or -ing form in some constructions using the passive voice. <br/>  You use the passive voice when you want to focus on the receiver of the action, rather than the doer (agent)."}, {"type": "text", "content": "If the subject is not the agent, you use a <span class=\"underline\">passive infinitive</span>:<br/><br/>  For example:<br/><br/>  <span class=\"italic\">The systems are <span class=\"strong\">to be checked</span> as soon as possible. </span><br/><br/>  You use <span class=\"underline\">passive -ing forms</span> after verbs that are normally followed by a gerund (love, recall etc.)<br/><br/>  For example:<br/><br/>  <span class=\"italic\">I <span class=\"strong\">love being given</span> chocolates!</span><br/><br/>  You can use the passive -ing form with the meaning of \u2018because'. <br/><br/>  For example:<br/><br/>  <span class=\"italic\"><span class=\"strong\">Having been bitten</span> by a dog, I have no love of them.</span>"}, {"type": "example", "content": "<span class=\"strong\">Being pressured</span> to meet a deadline may cause some employees to borrow someone else's ideas and present them as their own."}, {"type": "example", "content": "When you think about plagiarism, you usually think about writers' stories <span class=\"strong\">having been stolen</span> by other writers."}, {"type": "example", "content": "<span class=\"strong\">To be caught</span> plagiarizing copyrighted work can lead to fines. "}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": " Expressing Strong Disapproval"}, {"type": "describer", "content": " In a work environment there may come a time when you do not agree with or approve of a decision that somebody made. There are tactful ways to express your disapproval. "}, {"type": "text", "content": "Look at the chart below. It contains a list of phrases or expressions you can use. It ranks them from weak to stronger in meaning:"}, {"type": "table", "content": "{\"rows\":7,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<div class=\\\"center_text\\\">Phrase\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<div class=\\\"center_text\\\">Meaning\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"I don't think much of that.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"The speaker does not approve of an action and is not very upset. You can use this phrase to weakly agree with other people who are more angry or upset.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"I'm utterly appalled / disgusted.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" Stronger reactions to an action. You usually use these phrases immediately after you find out about the event or action.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"I'm dead against that.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" Speaking more generally about a kind of action that you always disapprove of.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"It shouldn't be allowed!\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Saying that you would like a new law to prevent people from doing something that you think is bad. This also suggests that the action is legal at the moment.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"What a rotten / mean thing to do\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" Very strong negative reaction to an action that you have just heard about. The speaker is also showing sympathy with the victim of the action.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Who do they think they are?<br/><br/>  How can people do things like that?\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" Showing strong negative reactions to an action. Showing particular disapproval of the people who did the actions.\\\"}\"],\"styles\":\" instruction_table_background intro_table_border\"}"}, {"type": "example", "content": "You may wonder, <span class=\"strong\">how can people do things like that</span>? <span class=\"strong\">It shouldn't be allowed</span> and it isn't, but it happens more often than we think. "}, {"type": "example", "content": "<span class=\"strong\">You may not think much of that</span> but it may have taken a programmer years to perfect. "}, {"type": "example", "content": "Many believe it is <span class=\"strong\">a rotten thing to do</span>."}]}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "What's your opinion about plagiarism? Write down your thoughts about it."}, {"type": "text", "content": "Go to the library or on the internet. "}, {"type": "text", "content": "Do some research. Find evidence from articles that support your opinion."}, {"type": "text", "content": "Use your research to write a short response paper (16-20 sentences) about your views on plagiarism."}, {"type": "text", "content": "Proofread your response."}, {"type": "text", "content": "Share it with a partner. Ask for their opinion."}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I form an opinion about an issue related to work."}, {"type": "text", "content": "I identify evidence that helps support my opinion."}, {"type": "text", "content": "I write about issues related to work."}]}], "labs": [{"_data": [{"type": "lab_options", "contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}]}], "stimuli": [{"_data": [], "template_override": 1, "type": "welcome", "contents": [{}], "id": 0}, {"id": 1, "type": "audio", "title": "", "_data": [], "template_override": 1, "contents": [{"type": "slideshow", "value": {"audiosrc": "engenn10le12ob07re2aud01", "coverimg": "engenn10le12ob07re2img05.jpg", "images": [{"text": "", "id": 0, "time": "0", "image": "engenn10le12ob07re2img05.jpg"}, {"text": "Being pressured to meet a deadline may cause some employees to borrow someone else's words, ideas or products and present them as their own. It is seen as a quick and easy way to be done with their work. This work \"borrowing\" is also known as plagiarism. You may wonder, how can people do things like that? It shouldn't be allowed and it isn't, but it happens more often than we think.", "id": 1, "time": "100", "image": "engenn10le12ob07re2img05.jpg"}, {"text": "When you think about plagiarism, you usually think about writers' stories being stolen by other writers. However, it goes beyond this, using reports, ad campaigns, brochure content or memos written by others and not giving the creator credit counts as plagiarism.\n<br>\nThe act of stealing someone else's work is an ethical and legal infringement, whether you're using a few lines written by someone else or an entire document. To be caught plagiarizing copyrighted work can lead to fines.", "id": 2, "time": "24000", "image": "engenn10le12ob07re2img01.jpg"}, {"text": "It's not always just text either. Let's take a software program for example. Behind every program is a detailed list of code. You may not think much of that but it may have taken years for a computer program to be perfected. Using anything that is part of a proprietary software being protected by copyright laws is also against the law.\n<br>\n\u201cWhat about art?\u201d you may ask. When you are creating art, you are inspired by the work of others. For a new design to be created, a lot of inspiration is required. If you use a design that closely mimics the original, you may have stepped over the line from influenced to copycat.", "id": 3, "time": "53500", "image": "engenn10le12ob07re2img02.jpg"}]}}]}], "id": 0, "type": "scholar", "exercises": [{"questions": [], "stimuli_ids": [0], "id": 0, "type": "WLC", "img_path": "", "_data": [{"type": "instructions", "contents": [{"type": "Learning Outcomes", "content": " I can express strong disapproval."}, {"type": "Learning Outcomes", "content": " I can talk about reactions and behavior in different situations related to work issues. "}, {"type": "Learning Outcomes", "content": " I can talk about expectations related to work issues. "}, {"type": "Free Header Item", "content": "  What do you think about copying someone else's work and using it as your own? "}, {"type": "Free Header Item", "content": "  Is it acceptable? Why or why not?"}]}, {"type": "group", "contents": [{"type": "group_name", "content": "Welcome"}]}, {"type": "feedback", "content": {"allowed_attempts": 2, "correct_feedback": "Correct", "attempt_feedback": [{"type": "text", "content": "You have 2 tries"}, {"type": "text", "content": "you have 1 attempt left"}], "incorrect_feedback": [{"type": "text", "content": "try again"}, {"type": "text", "content": "Maybe next time"}]}}, {"type": "free_header_text", "content": " Ask your partner:"}, {"type": "free_type_text_area", "content": "Is borrowing ideas a no-no in the workplace?"}], "template_override": 1}, {"questions": [{"_data": [{"type": "question", "contents": [{"type": "text", "content": ""}]}], "id": 0, "responses": [{"correct": 0, "_data": [{"type": "text", "content": ""}], "id": 0, "selected": 0}, {"correct": 1, "_data": [{"type": "text", "content": ""}], "id": 1, "selected": 0}]}], "stimuli_ids": [1], "id": 1, "type": "STI", "_data": [{"type": "instructions", "contents": [{"type": "text", "content": " \nAdam reads an article on business <span class=\"tool-tip\" id=\"tip_1_0\">ethics</span>.\n"}]}, {"type": "group", "contents": [{"type": "group_name", "content": "Content"}]}, {"type": "feedback", "content": {"allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}, {"type": "learning_skills", "contents": [{"type": "skill", "content": "Listening"}, {"type": "skill", "content": "Reading"}]}, {"type": "tips", "content": [{"tip_id": 0, "type": "text", "content": " <span class=\"italic\">\"Ethics\"</span> are a system of moral principles t